# Swara build environment. Source this before ./gradlew:
#   source .envrc
#
# JDK: the Temurin 17 Gradle provisions into its own jdks cache. There is no
# system JDK on this machine, so without this Gradle cannot start.
export JAVA_HOME="$HOME/.gradle/jdks/eclipse_adoptium-17-amd64-linux.2"
export ANDROID_HOME="$HOME/Android/Sdk"
export PATH="$JAVA_HOME/bin:$PATH"
